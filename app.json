{
  "expo": {
    "name": "추억 우체국",
    "slug": "memorypost",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.memorypost"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.memorypost",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "오늘 일정을 기기 안에서만 읽어 홈 화면에 보여 드려요. 일정은 어디에도 전송하지 않아요."
        }
      ]
    ],
    "scheme": "memorypost",
    "backgroundColor": "#F7F5F1",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4f7ec71d-a898-4a53-9f9d-e9b89477573a"
      }
    }
  }
}
