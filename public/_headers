# Cloudflare Pages response headers.
# The service worker and the page must be re-checked on every open so new deploys arrive.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
# Build files carry a content hash in their names.
/_expo/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
